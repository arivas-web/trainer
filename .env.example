# Pulse · variables del backend.
# En local: copia este archivo a .env.local (está en .gitignore).
# En producción: añade las mismas variables en Vercel → Project → Settings → Environment Variables.
# NUNCA subas valores reales al repo.

# --- Base de datos ---------------------------------------------------------------------
# Local: Postgres en Docker (make db-up).
# Supabase: cadena del "Transaction pooler" (puerto 6543), tal cual (postgres:// o
# postgresql:// se convierten solos). Si conectas Supabase desde Vercel, basta POSTGRES_URL.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/pulse

# --- Garmin Connect Personal API --------------------------------------------------------
# Tu clave API personal (Garmin Connect → Ajustes → Clave API personal). Caduca en 1 año.
GARMIN_PERSONAL_API_KEY=

# Opcional: clave Fernet para cifrar el token de 24 h cacheado en la base de datos (`make key`).
# Si no se define, se deriva de GARMIN_PERSONAL_API_KEY.
TOKEN_ENCRYPTION_KEY=

# --- Sincronización ---------------------------------------------------------------------
SYNC_PAUSE_S=0.4
SYNC_INITIAL_DAYS=365
SYNC_RESYNC_DAILY_DAYS=3
SYNC_AUTO_INTERVAL_H=6
# Secreto del cron (Vercel Cron lo envía como Bearer; pg_cron como X-Cron-Secret).
CRON_SECRET=

# --- Almacenamiento de FIT originales ---------------------------------------------------
# auto = supabase si hay SUPABASE_URL + SUPABASE_SERVICE_ROLE_KEY; si no, local (data/files)
STORAGE_BACKEND=auto
# La integración Supabase de Vercel crea estas variables sola (también POSTGRES_URL).
SUPABASE_URL=
# Clave pública (anon/publishable): el backend la sirve al frontend para el login.
SUPABASE_ANON_KEY=
# Clave secreta (service_role): solo en el servidor.
SUPABASE_SERVICE_ROLE_KEY=

# --- Acceso -----------------------------------------------------------------------------
# Único email autorizado (el tuyo).
ALLOWED_EMAIL=
# Solo si tu proyecto de Supabase firma los JWT con secreto HS256 (proyectos antiguos).
# Los proyectos nuevos usan claves asimétricas y basta con SUPABASE_URL.
SUPABASE_JWT_SECRET=
# true SOLO en desarrollo local, para no tener que hacer login.
AUTH_DISABLED=false

# Crear/actualizar las tablas automáticamente en el primer arranque.
AUTO_MIGRATE=true

ATHLETE_TIMEZONE=Europe/Madrid
