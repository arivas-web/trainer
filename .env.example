# Pulse · variables del backend.
# En local: copia este archivo a .env.local (está en .gitignore).
# En producción: añade las mismas variables en Vercel → Project → Settings → Environment Variables.
# NUNCA subas valores reales al repo.

# --- Base de datos ---------------------------------------------------------------------
# Local: Postgres en Docker (make db-up).
# Supabase (producción, desde Vercel): cadena del pooler en modo transacción (puerto 6543),
# Project Settings → Database → Connection string → "Transaction pooler", cambiando el
# prefijo a postgresql+psycopg://
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/pulse

# --- Garmin Connect Personal API --------------------------------------------------------
# Tu clave API personal (Garmin Connect → Ajustes → Clave API personal). Caduca en 1 año.
GARMIN_PERSONAL_API_KEY=

# Clave para cifrar el token de 24 h que se cachea en la base de datos. Genera una con:
#   make key
TOKEN_ENCRYPTION_KEY=

# --- Sincronización ---------------------------------------------------------------------
SYNC_PAUSE_S=0.4
SYNC_INITIAL_DAYS=365
SYNC_RESYNC_DAILY_DAYS=3
SYNC_AUTO_INTERVAL_H=6
# Secreto que pg_cron envía en X-Cron-Secret (genera otro con `make key`).
CRON_SECRET=

# --- Almacenamiento de FIT originales ---------------------------------------------------
# local (data/files) en desarrollo | supabase en producción
STORAGE_BACKEND=local
SUPABASE_URL=
# Project Settings → API → service_role (secreta: solo en el servidor, nunca en el frontend)
SUPABASE_SERVICE_ROLE_KEY=

# --- Acceso -----------------------------------------------------------------------------
# Único email autorizado (el tuyo).
ALLOWED_EMAIL=
# Solo si tu proyecto de Supabase firma los JWT con secreto HS256 (proyectos antiguos).
# Los proyectos nuevos usan claves asimétricas y basta con SUPABASE_URL.
SUPABASE_JWT_SECRET=
# true SOLO en desarrollo local, para no tener que hacer login.
AUTH_DISABLED=false

ATHLETE_TIMEZONE=Europe/Madrid
