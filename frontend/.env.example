# Frontend (Vite). Valores públicos: la clave "publishable/anon" de Supabase no da acceso a
# tus datos porque todas las tablas tienen RLS sin políticas; solo sirve para el login.
VITE_SUPABASE_URL=https://xxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=
# Solo desarrollo local con AUTH_DISABLED=true en el backend:
VITE_AUTH_DISABLED=false
