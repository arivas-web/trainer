{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "cd frontend && npm ci",
  "buildCommand": "cd frontend && npm run build",
  "outputDirectory": "frontend/dist",
  "regions": [
    "fra1"
  ],
  "functions": {
    "api/index.py": {
      "maxDuration": 60,
      "includeFiles": "backend/{app/**,alembic/**,alembic.ini}",
      "excludeFiles": "{frontend/**,backend/tests/**,backend/.venv/**,data/**}"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/sync/tick",
      "schedule": "17 5 * * *"
    }
  ]
}
